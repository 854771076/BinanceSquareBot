# BinanceSquareBot 配置示例
# 复制此文件为 .env 并填入实际配置值

# ============================================
# 全局配置
# ============================================

SQLITE_DB_PATH=data/app.db
LOG_LEVEL=INFO

# LLM 配置
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 生成参数
MAX_RETRIES=3
MIN_CHARS=101
MAX_CHARS=799
MAX_HASHTAGS=2
MAX_MENTIONS=2
# 长文（post_type=article）字符范围
ARTICLE_MIN_CHARS=800
ARTICLE_MAX_CHARS=15000

# ============================================
# FnSource 配置 (新闻源)
# 环境变量命名: FN_SOURCE_<FIELD_NAME>
# ============================================

FN_SOURCE_ENABLED=true
FN_SOURCE_DAILY_MAX_EXECUTIONS=30
FN_SOURCE_BASE_URL=https://api.foresightnews.pro
FN_SOURCE_TIMEOUT=30

# ============================================
# PolymarketSource 配置 (预测市场研报源)
# 环境变量命名: POLYMARKET_SOURCE_<FIELD_NAME>
# ============================================

POLYMARKET_SOURCE_ENABLED=false
POLYMARKET_SOURCE_DAILY_MAX_EXECUTIONS=10
POLYMARKET_SOURCE_HOST=https://clob.polymarket.com
POLYMARKET_SOURCE_MIN_VOLUME_THRESHOLD=1000.0
POLYMARKET_SOURCE_MIN_WIN_RATE=0.6
POLYMARKET_SOURCE_MAX_WIN_RATE=0.95

# ============================================
# FollowinSource 配置 (Followin热点/币种源)
# 环境变量命名: FOLLOWIN_SOURCE_<FIELD_NAME>
# ============================================

FOLLOWIN_SOURCE_ENABLED=true
FOLLOWIN_SOURCE_DAILY_MAX_EXECUTIONS=24
FOLLOWIN_SOURCE_BASE_URL=https://api.followin.io
FOLLOWIN_SOURCE_WEB_BASE_URL=https://followin.io
FOLLOWIN_SOURCE_TIMEOUT=30
FOLLOWIN_SOURCE_MAX_ITEMS_PER_CATEGORY=2
FOLLOWIN_SOURCE_GTOKEN=your-followin-gtoken-here

# ============================================
# BinanceTarget 配置 (币安广场发布目标)
# 环境变量命名: BINANCE_TARGET_<FIELD_NAME>
# ============================================

BINANCE_TARGET_ENABLED=true
BINANCE_TARGET_DAILY_MAX_POSTS_PER_KEY=100
BINANCE_TARGET_DAILY_MAX_UPLOADS_PER_KEY=400
# 多个 API Key 用逗号分隔
BINANCE_TARGET_API_KEYS=your-first-api-key,your-second-api-key
BINANCE_TARGET_API_URL=https://www.binance.com/bapi/composite/v1/public/pgc/openApi/content/add
BINANCE_TARGET_STOP_WORDS=bitget,okx,upbit,bitumb,kraken,bingx,coinbase
# 媒体上传轮询
BINANCE_TARGET_UPLOAD_POLL_INTERVAL=3.0
BINANCE_TARGET_UPLOAD_MAX_POLL_RETRIES=10
BINANCE_TARGET_UPLOAD_TIMEOUT=120.0

# ============================================
# PexelsSource 配置 (Pexels 免费图片源)
# 申请 API Key: https://www.pexels.com/api/
# 环境变量命名: PEXELS_SOURCE_<FIELD_NAME>
# ============================================

PEXELS_SOURCE_ENABLED=false
PEXELS_SOURCE_DAILY_MAX_EXECUTIONS=1
PEXELS_SOURCE_API_KEY=your-pexels-api-key
PEXELS_SOURCE_PER_KEYWORD=3
PEXELS_SOURCE_MAX_ITEMS_PER_RUN=10
PEXELS_SOURCE_ORIENTATION=landscape
PEXELS_SOURCE_MIN_WIDTH=1024
PEXELS_SOURCE_DOWNLOAD_DIR=data/media/pexels
# 逗号分隔；binance/bnb 等关键词会自动产出长文(article)
PEXELS_SOURCE_KEYWORDS=binance,bitcoin,ethereum,cryptocurrency,blockchain,candlestick chart

# ============================================
# SquareHotSource 配置 (币安广场热门逆向抓取 + AI 改写)
# 默认关闭；需要在 binance.com 登录态抓包确认 feed_url/feed_params 后再开
# 环境变量命名: SQUARE_HOT_SOURCE_<FIELD_NAME>
# ============================================

SQUARE_HOT_SOURCE_ENABLED=false
SQUARE_HOT_SOURCE_DAILY_MAX_EXECUTIONS=1
SQUARE_HOT_SOURCE_FEED_URL=https://www.binance.com/bapi/composite/v1/public/cms/article/list/query
SQUARE_HOT_SOURCE_FEED_PARAMS=type=1&catalogId=48&pageNo=1&pageSize=20
SQUARE_HOT_SOURCE_MAX_ITEMS_PER_RUN=5
SQUARE_HOT_SOURCE_MIN_LIKE_COUNT=50
SQUARE_HOT_SOURCE_SKIP_VERIFIED_AUTHORS=true
# 即使跳过认证作者，这些币安官方账号仍然抓取（逗号分隔 username），享受流量扶持
SQUARE_HOT_SOURCE_OFFICIAL_AUTHOR_WHITELIST=binance_news,binance,binance_research,binance_announcements,binance_alpha,binance_square,cz
# 官方号同脚本改写更严（跨脚本 EN->CN 永远通过）
SQUARE_HOT_SOURCE_OFFICIAL_SIMILARITY_THRESHOLD=0.7
SQUARE_HOT_SOURCE_MIN_CONTENT_CHARS=200
SQUARE_HOT_SOURCE_MAX_CONTENT_CHARS=6000
# 同脚本改写相似度上限（SequenceMatcher, 0-1）；跨脚本（EN->CN）永远通过
SQUARE_HOT_SOURCE_SIMILARITY_THRESHOLD=0.8
SQUARE_HOT_SOURCE_REQUEST_TIMEOUT=15.0

# ============================================
# BinanceAnnSource 配置 (币安官方公告润色源)
# 默认关闭；抓取币安官方公告并 AI 润色后发布
# catalogId: 48=交易对上新, 93=活动, 49=最新动态, 128=空投
# 环境变量命名: BINANCE_ANN_SOURCE_<FIELD_NAME>
# ============================================

BINANCE_ANN_SOURCE_ENABLED=false
BINANCE_ANN_SOURCE_DAILY_MAX_EXECUTIONS=3
BINANCE_ANN_SOURCE_PAGE_SIZE=10
BINANCE_ANN_SOURCE_MAX_ITEMS_PER_RUN=5
BINANCE_ANN_SOURCE_CATALOGS=48,93,49,128
BINANCE_ANN_SOURCE_MIN_BODY_CHARS=80
BINANCE_ANN_SOURCE_MAX_BODY_CHARS=12000
BINANCE_ANN_SOURCE_REQUEST_TIMEOUT=15.0
